{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "\u041d\u043e\u043c\u0435\u0440 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f"
    },
    "order_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0442\u0430 \u0447\u0430\u0441 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u041d\u043e\u0432\u0435",
        "\u0412 \u043e\u0431\u0440\u043e\u0431\u0446\u0456",
        "\u041e\u043f\u043b\u0430\u0447\u0435\u043d\u043e",
        "\u0412\u0438\u0440\u043e\u0431\u043d\u0438\u0446\u0442\u0432\u043e",
        "\u0412\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e",
        "\u0414\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e",
        "\u0412\u0438\u043a\u043e\u043d\u0430\u043d\u043e",
        "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f",
        "\u0421\u043a\u0430\u0441\u043e\u0432\u0430\u043d\u043e"
      ],
      "default": "\u041d\u043e\u0432\u0435",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f"
    },
    "total_amount": {
      "type": "number",
      "description": "\u0421\u0443\u043c\u0430 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f"
    },
    "payment_type": {
      "type": "string",
      "description": "\u0422\u0438\u043f \u043e\u043f\u043b\u0430\u0442\u0438"
    },
    "payer_name": {
      "type": "string",
      "description": "\u041f\u043b\u0430\u0442\u043d\u0438\u043a"
    },
    "delivery_type": {
      "type": "string",
      "enum": [
        "\u0421\u0430\u043c\u043e\u0432\u0438\u0432\u0456\u0437",
        "\u041d\u043e\u0432\u0430 \u041f\u043e\u0448\u0442\u0430",
        "\u0423\u043a\u0440\u043f\u043e\u0448\u0442\u0430",
        "\u041a\u0443\u0440'\u0454\u0440"
      ],
      "description": "\u0422\u0438\u043f \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"
    },
    "recipient_name": {
      "type": "string",
      "description": "\u041e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0447 \u041f\u0406\u0411"
    },
    "recipient_phone": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d \u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0447\u0430"
    },
    "manager_name": {
      "type": "string",
      "description": "\u041c\u0435\u043d\u0435\u0434\u0436\u0435\u0440"
    },
    "layout_url": {
      "type": "string",
      "description": "\u041f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u043d\u0430 \u043c\u0430\u043a\u0435\u0442\u0438"
    },
    "invoice_url": {
      "type": "string",
      "description": "\u0420\u0430\u0445\u0443\u043d\u043e\u043a \u0444\u0430\u043a\u0442\u0443\u0440\u0430 URL"
    },
    "ttn": {
      "type": "string",
      "description": "\u0422\u0422\u041d \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f"
    },
    "service_zone": {
      "type": "string",
      "description": "\u0417\u043e\u043d\u0430 \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f"
    },
    "comment": {
      "type": "string",
      "description": "\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u0434\u043e \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f"
    },
    "items": {
      "type": "array",
      "description": "\u0422\u043e\u0432\u0430\u0440\u0438 \u0432 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u0456",
      "items": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string"
          },
          "product_image": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "order_number",
    "order_date",
    "status",
    "total_amount"
  ]
}