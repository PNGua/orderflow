{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "first_name": {
      "type": "string",
      "description": "\u0406\u043c'\u044f"
    },
    "last_name": {
      "type": "string",
      "description": "\u041f\u0440\u0456\u0437\u0432\u0438\u0449\u0435"
    },
    "phone": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d"
    },
    "city": {
      "type": "string",
      "description": "\u041c\u0456\u0441\u0442\u043e"
    },
    "branch": {
      "type": "string",
      "description": "\u0424\u0456\u043b\u0456\u044f"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "\u0412\u043d\u0443\u0442\u0440\u0456\u0448\u043d\u0456\u0439 \u0431\u0430\u043b\u0430\u043d\u0441 (\u0433\u0440\u043d)"
    },
    "payers": {
      "type": "array",
      "description": "\u0421\u043f\u0438\u0441\u043e\u043a \u043f\u043b\u0430\u0442\u043d\u0438\u043a\u0456\u0432",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ipn": {
            "type": "string"
          }
        }
      }
    }
  }
}